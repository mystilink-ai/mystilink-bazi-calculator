{
  "title": "BaZi Calculate Output",
  "type": "object",
  "required": ["pillars", "bazi_ganzhi"],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Aligned with mystilink.bazi.chart/0.1 when present"
    },
    "bazi_schema_version": {
      "type": "string",
      "description": "Legacy package schema marker (still emitted as 1.0)"
    },
    "calendar_engine": {
      "type": "string",
      "enum": ["builtin", "lunar", "external_basis"],
      "description": "builtin default; lunar needs optional extra; external_basis via --calendar-basis"
    },
    "calendar_basis": {
      "type": "object",
      "description": "Optional nested snapshot when calendar_engine is lunar or external_basis"
    },
    "birth_date": { "type": "string" },
    "hour_interval": { "type": "integer" },
    "effective_hour": { "type": "integer" },
    "effective_minute": { "type": "integer" },
    "true_solar_time_enabled": { "type": "boolean" },
    "true_solar_time_delta_minutes": { "type": "number" },
    "birth": {
      "type": "object",
      "properties": {
        "datetime": { "type": "string" },
        "timezone": { "type": "string" }
      }
    },
    "pillars": {
      "type": "object",
      "properties": {
        "year": { "$ref": "#/$defs/pillar" },
        "month": { "$ref": "#/$defs/pillar" },
        "day": { "$ref": "#/$defs/pillar" },
        "hour": { "$ref": "#/$defs/pillar" }
      }
    },
    "bazi_ganzhi": { "type": "string" },
    "summary_zh": { "type": "string" },
    "bazi_grid_cells": { "type": "array" },
    "bazi_details": { "type": "array" }
  },
  "$defs": {
    "pillar": {
      "type": "object",
      "required": ["stem", "branch", "ganzhi", "text", "stem_index", "branch_index"],
      "properties": {
        "stem_index": { "type": "integer", "minimum": 0, "maximum": 9 },
        "branch_index": { "type": "integer", "minimum": 0, "maximum": 11 },
        "stem": { "type": "string" },
        "branch": { "type": "string" },
        "text": { "type": "string", "description": "stem + branch" },
        "ganzhi": { "type": "string", "description": "Legacy alias of text" },
        "stem_element": { "type": "string" },
        "branch_element": { "type": "string" },
        "zodiac": { "type": "string" }
      }
    }
  }
}
